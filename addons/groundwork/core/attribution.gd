@tool
class_name GwAttribution
extends RefCounted
## Collects the attribution of every provider used by an import.

var _providers: Array[GwTileProvider] = []


func add_provider(provider: GwTileProvider) -> void:
	if provider == null or provider in _providers:
		return
	_providers.append(provider)


func is_empty() -> bool:
	return _providers.is_empty()


## Full attribution text, one block per provider.
func to_text() -> String:
	var blocks := PackedStringArray()
	for p in _providers:
		blocks.append("%s:\n%s" % [p.get_label(), p.attribution.strip_edges()])
	return "\n\n".join(blocks)


## One line suitable for an on-screen label.
func to_short_text() -> String:
	var parts := PackedStringArray()
	for p in _providers:
		parts.append(p.attribution_short if not p.attribution_short.is_empty() else p.get_label())
	return " | ".join(parts)


func to_markdown(title: String, bbox: GwGeoBBox) -> String:
	var lines := PackedStringArray()
	lines.append("# Attribution: %s" % title)
	lines.append("")
	lines.append("Generated by Godot-Groundwork. The geographic data in this folder")
	lines.append("comes from the sources below. You must display their attribution wherever")
	lines.append("the data is shown (for example in your game's credits), and follow each")
	lines.append("provider's terms.")
	lines.append("")
	if bbox != null:
		lines.append("Area (south, west, north, east): %s" % str(bbox))
		lines.append("")
	for p in _providers:
		lines.append("## %s" % p.get_label())
		lines.append("")
		lines.append(p.attribution.strip_edges())
		lines.append("")
		if not p.terms_url.is_empty():
			lines.append("Terms: %s" % p.terms_url)
			lines.append("")
	return "\n".join(lines)
